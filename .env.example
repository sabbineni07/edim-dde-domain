# Databricks SQL warehouse (required for real collection)
DATABRICKS_HOST=adb-xxxxxxxx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Auth for SQL (two paths):
#   1) Databricks Apps — API middleware binds X-Forwarded-Access-Token
#   2) Local — `az login` (DefaultAzureCredential)
# Install: pip install 'edim-dde-domain[azure,databricks,llm]'

# Table FQNs interpolated into agent YAML SQL (${...})
# Must be catalog.schema.table or schema.table (letters/digits/underscore only)
DATABRICKS_SPARK_LOGS_TABLE=catalog.schema.spark_logs
DATABRICKS_SPARK_METRICS_TABLE=catalog.schema.spark_metrics
DATABRICKS_JOB_CLUSTER_METRICS_TABLE=catalog.schema.job_cluster_metrics

# Azure AI Foundry (OpenAI v1) — required for llm_chain (sizing / explanation / rca)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Foundry auth (same pattern as Databricks):
#   Local: `az login` (DefaultAzureCredential) — leave CLIENT_* empty
#   Prod: set SP below (load CLIENT_ID / CLIENT_SECRET from Azure Key Vault into env)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Optional: external agent plugin directories (nested *.agent.yaml + nodes.py)
# EDIM_AGENT_DIRS=/opt/edim-agents/acme,/opt/edim-agents/partner
