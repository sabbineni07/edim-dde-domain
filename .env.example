# Databricks SQL warehouse (required for real collection)
DATABRICKS_HOST=adb-xxxxxxxx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
# Optional PAT. If empty, auth mode "auto" uses DefaultAzureCredential
# (az login / Managed Identity) or AZURE_CLIENT_ID/SECRET/TENANT_ID.
# DATABRICKS_TOKEN=

# Table FQNs interpolated into agent YAML SQL (${...})
DATABRICKS_SPARK_LOGS_TABLE=catalog.schema.spark_logs
DATABRICKS_SPARK_METRICS_TABLE=catalog.schema.spark_metrics
DATABRICKS_JOB_CLUSTER_METRICS_TABLE=catalog.schema.job_cluster_metrics

# Offline demos/tests without Databricks (default true)
EDIM_DOMAIN_ALLOW_STUB=true
