# Databricks SQL warehouse (required for real collection)
DATABRICKS_HOST=adb-xxxxxxxx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Environment: sdbx | dev | uat | intg | prod  (Phase 0 focus: sdbx, dev, prod)
EDIM_ENV=dev

# Optional: default within-env workspace when request omits workspace_id
# (required if config/workspaces.yaml lists multiple workspaces for this env)
# EDIM_DEFAULT_WORKSPACE_ID=dev_1

# Observability backend: langsmith | mlflow | none | auto
# auto = langsmith when LANGCHAIN_TRACING_V2=true, else none
EDIM_OBSERVABILITY=langsmith
# Local Docker Compose defaults EDIM_OBSERVABILITY=none and forces
# LANGCHAIN_TRACING_V2=false so this file's LangSmith settings do not spam
# unreachable corporate endpoints inside containers. Override with:
#   EDIM_OBSERVABILITY=langsmith LANGCHAIN_TRACING_V2=true docker compose up

# Auth for SQL (two paths):
#   1) Databricks Apps — API middleware binds X-Forwarded-Access-Token
#   2) Local — `az login` (DefaultAzureCredential)
# Install: pip install 'edim-dde-domain[azure,databricks,llm,keyvault]'

# Table FQNs interpolated into agent YAML SQL (${...})
# Must be catalog.schema.table or schema.table (letters/digits/underscore only)
# For multi-workspace within EDIM_ENV, prefer config/workspaces.yaml — see
# docs/domain/workspace-resolver.md (process vars remain the empty-catalog fallback)
DATABRICKS_SPARK_LOGS_TABLE=catalog.schema.spark_logs
DATABRICKS_SPARK_METRICS_TABLE=catalog.schema.spark_metrics
DATABRICKS_JOB_CLUSTER_METRICS_TABLE=catalog.schema.job_cluster_metrics

# Azure AI Foundry (OpenAI v1) — required for llm_chain (sizing / explanation / rca)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Optional per-agent LLM overrides (agent YAML bindings.llm → ${ENV:VAR}).
# Bundled agents ship a commented demo covering llm + search + cosmos + sql-warehouse
# that reuses the process globals above (and DATABRICKS_* / EDIM_COSMOS_* /
# EDIM_AZURE_SEARCH_*). LLM sampling knobs (temperature / top_p / top_k /
# max_tokens) are literal numbers in YAML. Use distinct env names only when an
# agent needs a different target:
# EDIM_FOUNDRY_ENDPOINT_RCA=
# EDIM_FOUNDRY_DEPLOYMENT_RCA=
# EDIM_FOUNDRY_ENDPOINT_TUNING=
# EDIM_FOUNDRY_DEPLOYMENT_TUNING=

# Foundry auth — order: SP → API key → DefaultAzureCredential (az login / MI)
#   1) PROD / Apps: EDIM_FOUNDRY_TENANT_ID + CLIENT_ID + CLIENT_SECRET (often via KV)
#   2) Optional API key (skips az login when set):
# EDIM_FOUNDRY_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT_KEY=
#   3) Local without SP/key: `az login`
# Do NOT set AZURE_CLIENT_ID/SECRET for Foundry (pollutes SQL DefaultAzureCredential).
# EDIM_FOUNDRY_TENANT_ID=
# EDIM_FOUNDRY_CLIENT_ID=
# EDIM_FOUNDRY_CLIENT_SECRET=
# Legacy (deprecated): AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID as Foundry SP

# Azure Key Vault bootstrap (API lifespan). Opens vault via Apps SP / MI / EDIM_KV_*.
# Loads Foundry SP into EDIM_FOUNDRY_* (default map) — not AZURE_CLIENT_*.
# AZURE_TENANT_ID=   # directory GUID for Apps SP client-credentials to Key Vault
# AZURE_KEY_VAULT_URL=https://edim-dde-dev-kv.vault.azure.net/
# EDIM_KV_SECRET_MAP=EDIM_FOUNDRY_CLIENT_ID:azure-client-id,EDIM_FOUNDRY_CLIENT_SECRET:azure-client-secret,EDIM_FOUNDRY_TENANT_ID:azure-tenant-id,LANGCHAIN_API_KEY:langchain-api-key
# Format is ENV_VAR_NAME:vaultSecretName (do not reverse to vaultSecretName:ENV_VAR_NAME)
# (omit EDIM_KV_SECRET_MAP to use the same default map — see docs/platform/key-vault-bootstrap.md)
# EDIM_KV_FORCE=0
# Optional dedicated vault reader (rare): EDIM_KV_CLIENT_ID / EDIM_KV_CLIENT_SECRET / EDIM_KV_TENANT_ID

# LangSmith (SDBX / DEV / PROD — one tracing project per EDIM env)
# EDIM uses LangGraph auto-tracing — NOT the LangSmith UI "OpenAI Agents SDK" sample.
# Full guide: docs/platform/langsmith-setup.md
EDIM_OBSERVABILITY=langsmith
# LANGCHAIN_TRACING_V2=true          # required — turns on LangGraph → LangSmith
# LANGCHAIN_API_KEY=lsv2_pt_...      # or Key Vault → LANGCHAIN_API_KEY
# LANGCHAIN_PROJECT=edim-dde-dev     # tracing project (Runs tab) — not EDIM_ENV
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# Self-hosted example:
# LANGCHAIN_ENDPOINT=https://your-langsmith-host.example.net/api/v1
# LANGCHAIN_PROJECT=edim-dde-ai-sdbx
# Optional LANGSMITH_* aliases (many versions accept both; keep LANGCHAIN_TRACING_V2):
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=edim-dde-dev
# LANGSMITH_ENDPOINT=...
# EDIM kill switch only (unset or false — do NOT set to "auto"):
# EDIM_LANGSMITH_ENABLED=false

# MLflow (optional — EDIM_OBSERVABILITY=mlflow; pip install 'edim-dde-ai[mlflow]')
# EDIM_MLFLOW_EXPERIMENT=edim-dde
# MLFLOW_TRACKING_URI=databricks

# Control-plane state store: memory | postgres | cosmos | redis
# Holds: agent catalog (owner/lifecycle), sessions, audit — NOT recommendation bodies.
# Git (Azure DevOps *.agent.yaml) remains source of truth for graphs.
# See docs/platform/state-store.md
# EDIM_STATE_STORE=memory
# Local Postgres (docker compose -f docker-compose.state-store.yml up -d):
# EDIM_STATE_STORE=postgres
# EDIM_DATABASE_URL=postgresql://edim:edim@localhost:5432/edim
# Deployed Cosmos:
# EDIM_STATE_STORE=cosmos
# EDIM_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# EDIM_COSMOS_KEY=...
# EDIM_COSMOS_DATABASE=edim
# Optional Redis:
# EDIM_STATE_STORE=redis
# EDIM_REDIS_URL=redis://localhost:6379/0
# Optional catalog stamp:
# EDIM_GIT_SHA=

# LangGraph session checkpoints for multi-turn analysis (memory | postgres)
# Local Compose / host-run with Postgres: postgres (survives API restarts)
# EDIM_CHECKPOINTER=postgres
# In-process only (lost on restart — tests / ephemeral):
# EDIM_CHECKPOINTER=memory

# Recommendation / product history store (default inherits EDIM_STATE_STORE)
# Holds: tuning/RCA recommendation rows + status (proposed|accepted|applied|…)
# Example: { recommendation_id, agent_id, job_id, status, request, response }
# none | memory | postgres | cosmos | redis | auto
# Guide: docs/platform/recommendation-store.md  ·  vs StateStore: docs/reference/env-vars.md
# EDIM_RECOMMENDATION_STORE=auto
# EDIM_RECOMMENDATION_STORE=none
# EDIM_RECOMMENDATION_STORE=cosmos
# EDIM_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# EDIM_COSMOS_KEY=...
# EDIM_COSMOS_DATABASE=edim
# EDIM_COSMOS_RECOMMENDATIONS_CONTAINER=recommendations

# Retrieval / RAG (similarity search backends)
# none | memory | faiss | azure_ai_search | databricks_vector
# Deployed default: azure_ai_search · Local: faiss (path = local dir or Databricks Volume)
# EDIM_RETRIEVAL=none
# Local FAISS:
# EDIM_RETRIEVAL=faiss
# EDIM_FAISS_INDEX_PATH=/tmp/edim-indexes
# # or: EDIM_FAISS_INDEX_PATH=/Volumes/catalog/schema/edim_indexes
# Deployed Azure AI Search:
# (Setup walkthrough: docs/platform/retrieval-and-rag.md §8)
# EDIM_RETRIEVAL=azure_ai_search
# EDIM_AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
# EDIM_AZURE_SEARCH_KEY=...
# EDIM_AZURE_SEARCH_INDEX=spark-runbooks
# Basic SKU (3 indexes): share outcomes → edim-outcomes
# EDIM_AZURE_SEARCH_CORPUS_MAP=spark-rca-outcomes:edim-outcomes,cluster-tuning-outcomes:edim-outcomes
# Optional Databricks Vector Search (per-corpus override also in corpora.yaml):
# EDIM_RETRIEVAL=databricks_vector
# EDIM_DBX_VS_ENDPOINT=...
# EDIM_DBX_VS_INDEX=...

# Optional public-web enrichment (RCA YAML nodes are disabled by default).
# Provider adapter contract: GET endpoint?q=...&count=... → JSON results.
# EDIM_WEB_SEARCH=none
# EDIM_WEB_SEARCH=http_json
# EDIM_WEB_SEARCH_ENDPOINT=https://<approved-search-gateway>/search
# EDIM_WEB_SEARCH_API_KEY=...
# EDIM_WEB_SEARCH_KEY_HEADER=Ocp-Apim-Subscription-Key
# EDIM_WEB_SEARCH_TIMEOUT_SECONDS=8

# Optional: external agent plugin directories (nested *.agent.yaml + nodes.py)
# EDIM_AGENT_DIRS=/opt/edim-agents/acme,/opt/edim-agents/partner

# API CORS (comma-separated). Empty = no browser CORS.
# EDIM_CORS_ORIGINS=https://localhost:4200
